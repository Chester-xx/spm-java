<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!--  Screen title  -->
    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/settings_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!--  Expiring soon highlighting on or off  -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_expiring_alerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_expiring_alerts"
        android:textSize="16sp" />

    <!--  Explains the switch, filled in code so the number of days is not repeated here  -->
    <TextView
        android:id="@+id/text_expiring_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textSize="14sp" />

    <!--  Unit pre-selected when adding an ingredient  -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_default_unit"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_default_unit"
        app:helperText="@string/settings_default_unit_help"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown_default_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>