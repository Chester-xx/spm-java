<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Always dark, GitHub style. No light variant and no user toggle. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Colours -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_subtle</item>
        <item name="colorOnPrimaryContainer">@color/green_light</item>
        <item name="colorSecondaryContainer">@color/green_subtle</item>
        <item name="colorOnSecondaryContainer">@color/green_light</item>
        <item name="colorSurface">@color/canvas</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="colorError">@color/red_light</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>

        <!-- Widget styles -->
        <item name="materialButtonStyle">@style/Widget.Spm.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Spm.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="bottomNavigationStyle">@style/Widget.Spm.BottomNav</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Spm.Dialog</item>
    </style>

    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />

    <!-- Buttons -->
    <!-- Green filled button for safe actions -->
    <style name="Widget.Spm.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Grey bordered button for secondary actions -->
    <style name="Widget.Spm.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Red bordered button for unsafe actions -->
    <style name="Widget.Spm.Button.Danger" parent="Widget.Spm.Button.Outlined">
        <item name="android:textColor">@color/red_light</item>
        <item name="strokeColor">@color/red</item>
        <item name="rippleColor">@color/red</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.Spm.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Spm.NavIndicator</item>
    </style>

    <style name="Widget.Spm.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_subtle</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.Spm.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Spm.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dialogs: red confirm button for destructive actions is set in code -->
    <style name="ThemeOverlay.Spm.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorPrimary">@color/green_light</item>
    </style>

</resources>
